# Copie este arquivo para ".env" e preencha com suas credenciais.
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
# Use primeiro as credenciais de TESTE (começam com TEST-) e depois as de produção (APP_USR-).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# true = abre o checkout de testes (sandbox_init_point). Use false em produção.
MP_SANDBOX=true

# Assinatura secreta dos webhooks (Suas integrações > Webhooks). Opcional, mas recomendado.
MP_WEBHOOK_SECRET=

# Porta do servidor e URL pública do site (sem barra no final).
# Em produção use a URL https real; com https o Mercado Pago faz o retorno
# automático para o site e envia as notificações (webhook).
PORT=3000
PUBLIC_URL=http://localhost:3000

# Taxa de entrega cobrada no delivery (em reais). 0 = grátis.
VALOR_ENTREGA=0
